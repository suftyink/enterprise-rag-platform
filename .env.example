APP_NAME=Cross-border ERP AI Assistant
APP_ENV=development
API_PREFIX=/api/assistant/v1
DATABASE_URL=postgresql+asyncpg://erp_assistant:erp_assistant@localhost:5432/erp_assistant
REDIS_URL=redis://localhost:6379/0
IDENTITY_PROVIDER=test
# Development/CI only. Production must use OIDC and must leave this empty.
INTERNAL_WEB_TEST_SUBJECT=
IDENTITY_MEMBERSHIPS_JSON={}
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_SUBJECT_CLAIM=sub
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile
INTERNAL_WEB_BASE_URL=http://localhost:8000
INTERNAL_WEB_SESSION_TTL_SECONDS=28800
INTERNAL_WEB_AUTH_STATE_TTL_SECONDS=600
MODEL_PROVIDER=fake
EMBEDDING_PROVIDER=fake
RERANK_PROVIDER=fake
# Set both retrieval providers to http for production profiles. Keep secrets outside Git.
ORDINARY_EMBEDDING_BASE_URL=
ORDINARY_EMBEDDING_API_KEY=
ORDINARY_EMBEDDING_DEPLOYMENT=
ORDINARY_EMBEDDING_MODEL=
ORDINARY_EMBEDDING_VERSION=
ORDINARY_EMBEDDING_DIMENSION=0
ORDINARY_RERANK_BASE_URL=
ORDINARY_RERANK_API_KEY=
ORDINARY_RERANK_DEPLOYMENT=
ORDINARY_RERANK_MODEL=
ORDINARY_RERANK_VERSION=
RESTRICTED_EMBEDDING_BASE_URL=
RESTRICTED_EMBEDDING_API_KEY=
RESTRICTED_EMBEDDING_DEPLOYMENT=
RESTRICTED_EMBEDDING_MODEL=
RESTRICTED_EMBEDDING_VERSION=
RESTRICTED_EMBEDDING_DIMENSION=0
RESTRICTED_RERANK_BASE_URL=
RESTRICTED_RERANK_API_KEY=
RESTRICTED_RERANK_DEPLOYMENT=
RESTRICTED_RERANK_MODEL=
RESTRICTED_RERANK_VERSION=
RETRIEVAL_PROVIDER_TIMEOUT_SECONDS=10
# JSON array of pre-approved model/index bindings, including parser_version and chunk_version.
RETRIEVAL_RUNTIME_DEPLOYMENTS=[]
RESTRICTED_KNOWLEDGE_DOCUMENT_KEYS=
ORDINARY_KNOWLEDGE_SHA256=
RESTRICTED_KNOWLEDGE_SHA256=
RESTRICTED_PROVIDER_ALLOWED_HOSTS=
RAG_ENABLED=false
PILOT_RELEASE_FINGERPRINT=
MILVUS_URI=http://localhost:19530
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erp-knowledge
MILVUS_COLLECTION=knowledge_chunks_hybrid_v2
RESTRICTED_MILVUS_COLLECTION=knowledge_chunks_restricted_v1
RAG_RRF_K=60
RAG_CANDIDATE_MULTIPLIER=4
RAG_MAX_CANDIDATES=80
RAG_RERANK_THRESHOLD=0.10
KNOWLEDGE_MAX_FILE_SIZE=20971520
